# MongoDB connection string (MongoDB Atlas free tier works great).
# If omitted, the app still runs — it just won't persist logs.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/guardrail?retryWrites=true&w=majority

# Optional: if set, Stage 1 (toxicity check) calls OpenAI's real moderation
# endpoint instead of the built-in keyword/regex fallback.
OPENAI_API_KEY=

# Port for the local Express dev server (not used on Vercel).
PORT=3001
